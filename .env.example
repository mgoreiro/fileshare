# Copia este fichero como .env y ajusta los valores antes de desplegar

PORT=3000

# Credenciales del panel de administración (solo se aplican la primera vez
# que arranca el contenedor, o si RESET_ADMIN=true)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secreto para firmar las cookies de sesión. Usa una cadena larga y aleatoria.
SESSION_SECRET=please_change_this_secret

# URL pública desde la que se accederá al servicio (se usa para construir los
# enlaces directos de descarga). Cambia esto por tu dominio/IP real.
BASE_URL=http://localhost:3000

# Tamaño máximo de fichero permitido, en MB. Usa 0 para no aplicar ningún límite
# (ten en cuenta el espacio en disco disponible y, si usas un proxy delante,
# que este tampoco imponga su propio límite).
MAX_FILE_SIZE_MB=500

# Carpeta vigilada: cualquier fichero que se deje en ./data/watch (en el host) se
# da de alta automáticamente, como si se hubiera subido desde el panel. Pon
# WATCH_ENABLED=false para desactivar esta función.
WATCH_ENABLED=true

# --- Notificaciones de Telegram en cada descarga (opcional) ---
# Deja ambas vacías para desactivar esta función. Ver la sección "Notificaciones
# de Telegram" del README para cómo crear el bot y obtener estos dos valores.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: además del TELEGRAM_CHAT_ID de arriba (que recibe las notificaciones de
# descarga), puedes indicar aquí una lista de chat_id separados por comas a los que
# se les permite usar los COMANDOS del bot (/status, /list, /delete, /subir,
# /listardescargas). Si lo dejas vacío, se usa TELEGRAM_CHAT_ID como único autorizado.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Solo necesario si usas docker-compose.https.yml (HTTPS con Let's Encrypt) ---

# Dominio público que apunta (registro DNS A/AAAA) a la IP de este servidor.
# Caddy lo usará para pedir automáticamente un certificado a Let's Encrypt.
DOMAIN=ficheros.midominio.com

# Marca la cookie de sesión como "solo HTTPS". Ponlo en true cuando uses
# docker-compose.https.yml (ya se fuerza automáticamente en ese fichero).
# Déjalo en false si accedes en HTTP plano (docker-compose.yml normal).
COOKIE_SECURE=false

# Poner en "true" una vez para forzar el reseteo del usuario/contraseña admin,
# luego volver a "false" o eliminar la variable.
RESET_ADMIN=false

# Cada cuántos minutos se comprueba (y corrige si hace falta) que el tamaño
# registrado de cada fichero coincide con su tamaño real en disco, además de
# la comprobación que ya se hace siempre al arrancar. Pon 0 para desactivar
# esta comprobación periódica y dejar solo la de arranque.
SIZE_CHECK_INTERVAL_MINUTES=60
